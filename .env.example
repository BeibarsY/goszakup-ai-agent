# Скопируйте в .env и заполните. .env не коммитить и не включать в образ.

# Токен OWS v3 (goszakup.gov.kz) — нужен только сервису updater
GOSZAKUP_TOKEN=

# Пароль PostgreSQL (контейнер postgres). Для локального запуска скриптов на хосте:
# DATABASE_URL=postgresql://postgres:<пароль>@127.0.0.1:5433/goszakup
POSTGRES_PASSWORD=
DATABASE_URL=

# LLM: по умолчанию контейнер ollama. На Mac быстрее Ollama на хосте (Metal),
# см. docker-compose.host-llm.yml
LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://ollama:11434/v1

# Обновление: интервал (ч), окно перекрытия (ч), полная сверка лотов и договоров (дни), порог массового удаления
UPDATE_INTERVAL_HOURS=6
UPDATE_OVERLAP_HOURS=24
UPDATE_FULL_EVERY_DAYS=7
ETL_MAX_DELETE_SHARE=0.10
